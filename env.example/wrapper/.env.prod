# Wrapper application — production
# Loaded together with env/lightrag-config/.env.prod.

APP_ENV=prod

LIGHTRAG_MODE=server
# Host-side URL. Compose replaces this with http://lightrag:9621.
LIGHTRAG_SERVER_URL=http://127.0.0.1:9621
LIGHTRAG_SERVER_TIMEOUT=180
LIGHTRAG_INGEST_WAIT=true
LIGHTRAG_INGEST_TIMEOUT=900
LIGHTRAG_QUERY_MODE=mix

APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# LightRAG embedded paths (unused while LIGHTRAG_MODE=server).
WORKING_DIR=./data/embedded/rag_storage
INPUT_DIR=./data/embedded/inputs

# Wrapper API staging for multipart /ingest/file. Not LightRAG INPUT_DIR.
WRAPPER_UPLOAD_DIR=./data/wrapper/uploads

NEO4J_USERNAME=neo4j
NEO4J_PASSWORD="abcd1234"