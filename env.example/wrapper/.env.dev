# Wrapper application — development
# Loaded together with env/lightrag-config/.env.dev (see APP_ENV / WRAPPER_ENV_FILE).

APP_ENV=dev

# embedded = in-process LightRAG SDK
# server   = HTTP client against a standalone lightrag-server
LIGHTRAG_MODE=embedded

# Used when LIGHTRAG_MODE=server
LIGHTRAG_SERVER_URL=http://127.0.0.1:9621
LIGHTRAG_SERVER_TIMEOUT=120
LIGHTRAG_INGEST_WAIT=true
LIGHTRAG_INGEST_TIMEOUT=600
LIGHTRAG_QUERY_MODE=mix

APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=DEBUG

# Embedded SDK store (wrapper wins over lightrag-config when both files load).
# Do not share these with the standalone server.
WORKING_DIR=./data/embedded/rag_storage
INPUT_DIR=./data/embedded/inputs

# Wrapper API staging for multipart /ingest/file. Not LightRAG INPUT_DIR.
WRAPPER_UPLOAD_DIR=./data/wrapper/uploads

# Optional client key for server mode. If unset, the value from
# env/lightrag-config is used when both files are loaded.
# LIGHTRAG_API_KEY=oLzboH8cy96Z1dzEjUSpS9anQT_qnh73WzX0Y8XCrCE
