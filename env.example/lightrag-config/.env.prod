# LightRAG server / embedded SDK — production
# Fill in secrets before deploying. Prefer a server-backed store over
# the default JSON/Nano/NetworkX files for real workloads.

############################
# LightRAG server process
############################
HOST=0.0.0.0
PORT=9621
# ENABLE_API_DOCS=false

############################
# Auth — required when the server is network-exposed
############################
LIGHTRAG_API_KEY=e_maiY5ukvim-d0fX7megbgeiieIRvzLGABc9HC83ak
WHITELIST_PATHS=/health

############################
# Directories (paths inside the LightRAG container)
# Host folders are ./data/server/... via Compose volume interpolation.
############################
WORKING_DIR=/app/data/rag_storage
INPUT_DIR=/app/data/inputs
# WORKSPACE=

############################
# LLM (openai | azure_openai | ollama)
# Inside Docker, use host.docker.internal instead of localhost.
############################
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=your_api_key
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=240
MAX_ASYNC_LLM=4
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# LiteLLM service reliability (used by lightrag_wrapper.llm.LLMService)
LLM_NUM_RETRIES=3
LLM_RETRY_STRATEGY=exponential_backoff_retry
LLM_RETRY_MIN_WAIT=1
LLM_RETRY_MAX_WAIT=10
LLM_DROP_PARAMS=true

############################
# Embedding
############################
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=your_api_key
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_BATCH_NUM=32
EMBEDDING_FUNC_MAX_ASYNC=8

############################
# Storage
# Postgres: KV + document status
# Milvus:   vectors
# Neo4j:    knowledge graph (Bloom at http://127.0.0.1:7474/bloom/)
#
# Inside Docker Compose these hosts are overridden to service names
# (postgres / neo4j / milvus). localhost is for a host-side client.
############################
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
LIGHTRAG_VECTOR_STORAGE=MilvusVectorDBStorage

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DATABASE=rag
POSTGRES_MAX_CONNECTIONS=25

NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j@lightrag
NEO4J_DATABASE=neo4j

MILVUS_URI=http://localhost:19530
MILVUS_DB_NAME=lightrag
MILVUS_DEVICE=cpu

# Milvus object store (Compose interpolation + milvus-minio)
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=minioadmin

############################
# Document parser
# Docling handles laid-out files (pdf, office, html, images).
# Extensions it does not support fall through to legacy.
# Compose overrides DOCLING_ENDPOINT to http://docling:5001.
############################
LIGHTRAG_PARSER=*:docling;*:legacy
DOCLING_ENDPOINT=http://127.0.0.1:5001

############################
# Indexing / query
############################
MAX_PARALLEL_INSERT=3
SUMMARY_LANGUAGE=English
ENABLE_LLM_CACHE=true
TOP_K=40
CHUNK_TOP_K=20
MAX_ENTITY_TOKENS=6000
MAX_RELATION_TOKENS=8000
MAX_TOTAL_TOKENS=30000
