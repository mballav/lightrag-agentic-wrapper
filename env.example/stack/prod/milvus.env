# Milvus root user.
# COMMON_SECURITY_DEFAULTROOT* is the server setting for the same MILVUS_USER / MILVUS_PASSWORD.
# etcd keeps the root password from the first time authorization was enabled.

MILVUS_USER=root
MILVUS_PASSWORD="abcd1234"
COMMON_SECURITY_AUTHORIZATIONENABLED=true
COMMON_SECURITY_DEFAULTROOTUSERNAME=root
COMMON_SECURITY_DEFAULTROOTPASSWORD="abcd1234"
