# MinIO root user. Milvus uses MINIO_ACCESS_KEY_ID / MINIO_SECRET_ACCESS_KEY
# for the same account as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
# A volume keeps the password from the first time it was created.

MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY="abcd1234"
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD="abcd1234"
